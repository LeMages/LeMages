---
import { skillCategories } from '../data/experience';
---

<section id="expertise" class="expertise">
  <div class="container" data-reveal>
    <div class="section-label">Compétences</div>
    <h2 class="section-title">Stack & expertise<span>.</span></h2>
    <p class="expertise-desc">
      Les outils que j'utilise pour passer de la donnée brute à des modèles en production.
    </p>

    <div class="categories">
      {skillCategories.map((cat) => (
        <div class="category">
          <div class="category-label">{cat.label}</div>
          <div class="skills-row">
            {cat.skills.map((skill) => (
              <div class="skill-card">
                <span class="skill-icon">{skill.abbr}</span>
                <span class="skill-label">{skill.label}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .expertise {
    padding: 86px 0;
    border-top: 1px solid var(--line);
  }

  .expertise-desc {
    font: 400 17px / 1.6 'Manrope', sans-serif;
    color: var(--muted);
    max-width: 560px;
    margin: 10px 0 48px;
  }

  .categories {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .category-label {
    font: 600 11px 'Space Grotesk', sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .skills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
    cursor: default;
  }

  .skill-card:hover {
    border-color: var(--accent-soft);
    transform: translateY(-2px);
  }

  .skill-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 11px 'Space Grotesk', sans-serif;
    color: var(--accent);
    flex-shrink: 0;
  }

  .skill-label {
    font: 600 13px 'Manrope', sans-serif;
    color: var(--text);
    white-space: nowrap;
  }
</style>
