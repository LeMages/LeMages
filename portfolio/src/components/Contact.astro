---
---

<section id="contact" class="contact">
  <div class="container" data-reveal>
    <div class="section-label">Contact</div>
    <h2 class="contact-title">
      Un poste à pourvoir, un projet&nbsp;?
      <span>Parlons-en.</span>
    </h2>

    <div class="contact-cards">
      <div class="contact-card">
        <div class="contact-card-num">01</div>
        <div class="contact-card-label">Email</div>
        <a href="mailto:loiccupif@gmail.com" class="contact-card-value">
          loiccupif@gmail.com
        </a>
      </div>

      <div class="contact-card">
        <div class="contact-card-num">02</div>
        <div class="contact-card-label">LinkedIn</div>
        <a
          href="https://www.linkedin.com/in/loiccupif/"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card-value"
        >
          /in/loiccupif
        </a>
      </div>

      <div class="contact-card">
        <div class="contact-card-num">03</div>
        <div class="contact-card-label">Localisation</div>
        <div class="contact-card-value">Paris, France</div>
      </div>
    </div>

    <a href="mailto:loiccupif@gmail.com" class="contact-cta">
      Envoyer un email →
    </a>
  </div>
</section>

<style>
  .contact {
    padding: 96px 0;
    border-top: 1px solid var(--line);
  }

  .contact-title {
    font: 700 clamp(34px, 5.5vw, 60px) / 1.04 'Space Grotesk', sans-serif;
    letter-spacing: -0.025em;
    margin: 20px 0 0;
    max-width: 760px;
    color: var(--text);
  }

  .contact-title span {
    color: var(--accent);
  }

  .contact-cards {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 18px;
    margin-top: 46px;
  }

  .contact-card {
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color 0.2s ease;
  }

  .contact-card:hover {
    border-color: var(--accent-soft);
  }

  .contact-card-num {
    font: 700 14px 'Space Grotesk', sans-serif;
    color: var(--accent);
  }

  .contact-card-label {
    font: 600 12px 'Manrope', sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 14px;
  }

  .contact-card-value {
    font: 600 17px 'Manrope', sans-serif;
    color: var(--text);
    margin-top: 6px;
    display: block;
    text-decoration: none;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  a.contact-card-value:hover {
    color: var(--accent);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 34px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 700 16px 'Manrope', sans-serif;
    padding: 16px 28px;
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .contact-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.07);
  }

  @media (max-width: 768px) {
    .contact-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
