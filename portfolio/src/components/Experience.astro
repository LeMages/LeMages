---
import { experiences } from '../data/experience';
---

<section id="parcours" class="experience">
  <div class="container" data-reveal>
    <div class="section-label">Career path</div>
    <h2 class="section-title">Parcours<span>.</span></h2>

    <div class="timeline">
      {experiences.map((exp) => (
        <div class="timeline-item">
          <div class="timeline-meta">
            <div class="timeline-period">{exp.period}</div>
            <div class="timeline-company">{exp.company} · {exp.location}</div>
            <span class={`timeline-badge ${exp.type === 'stage' ? 'badge-stage' : 'badge-formation'}`}>
              {exp.typeLabel}
            </span>
          </div>

          <div class="timeline-content">
            <h3 class="timeline-title" set:html={exp.title} />
            <ul class="timeline-bullets">
              {exp.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 86px 0;
    border-top: 1px solid var(--line);
  }

  .timeline {
    margin-top: 36px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 30px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }

  .timeline-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .timeline-period {
    font: 700 14px 'Space Grotesk', sans-serif;
    color: var(--text);
  }

  .timeline-company {
    font: 500 14px 'Manrope', sans-serif;
    color: var(--muted);
    margin-top: 4px;
  }

  .timeline-badge {
    display: inline-block;
    margin-top: 10px;
    font: 600 11px 'Manrope', sans-serif;
    padding: 4px 10px;
    border-radius: 7px;
  }

  .badge-stage {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .badge-formation {
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
  }

  .timeline-title {
    font: 700 20px 'Space Grotesk', sans-serif;
    color: var(--text);
    margin: 0;
  }

  .timeline-bullets {
    margin: 14px 0 0;
    padding: 0 0 0 18px;
    list-style: disc;
    color: #bcbcc4;
    font: 400 15px / 1.7 'Manrope', sans-serif;
  }

  .timeline-bullets li + li {
    margin-top: 6px;
  }

  @media (max-width: 700px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
