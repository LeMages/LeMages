---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Loïc Cupif — Data Engineer & ML',
  description = 'Étudiant ingénieur en 5ème année Data Engineering & Machine Learning à l\'EFREI Paris. Je construis des pipelines de bout en bout — de l\'ingestion à la prévision, jusqu\'au monitoring.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div style="position:relative;overflow-x:hidden;background:var(--bg);min-height:100vh;">
      <slot />
    </div>

    <script>
      function setupReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!els.length) return;

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('revealed');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px 0px 0px' }
        );

        els.forEach((el) => io.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReveal);
      } else {
        setupReveal();
      }
    </script>
  </body>
</html>
