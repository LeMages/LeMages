---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const allProjets = await getCollection('projets');
const sorted = allProjets.sort((a, b) => a.data.ordre - b.data.ordre);
const featured = sorted.filter((p) => p.data.featured);
const secondary = sorted.filter((p) => !p.data.featured);
---

<BaseLayout
  title="Projets — Loïc Cupif"
  description="Découvrez mes projets en Data Engineering, Machine Learning, simulation et développement web."
>
  <Nav currentPath="/projets" />

  <main>
    <section class="hero-projets">
      <div class="glow" aria-hidden="true"></div>
      <div class="container">
        <div class="section-label">Portfolio</div>
        <h1 class="page-title">Projets<span>.</span></h1>
        <p class="page-desc">
          Une sélection de projets personnels, entrepreneuriaux et scolaires — data, ML, algorithmes et web.
        </p>
      </div>
    </section>

    <!-- PROJETS PRINCIPAUX -->
    <section class="featured-section">
      <div class="container">
        <div class="section-label" data-reveal>Projets principaux</div>
        <div class="featured-grid">
          {featured.map((projet) => (
            <a href={`/projets/${projet.id}`} class="card-featured">
              <div class="card-img">
                {projet.data.image ? (
                  <img
                    src={projet.data.image}
                    alt={projet.data.titre}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    onerror="this.parentElement.classList.add('no-img')"
                  />
                ) : null}
                <div class="card-img-overlay" aria-hidden="true"></div>
                {projet.data.contexteGroupe && (
                  <span class="badge-groupe">Projet de groupe</span>
                )}
              </div>
              <div class="card-body">
                <div class="card-stack">
                  {projet.data.stack.slice(0, 4).map((tech) => (
                    <span class="tag-muted">{tech}</span>
                  ))}
                  {projet.data.stack.length > 4 && (
                    <span class="tag-muted">+{projet.data.stack.length - 4}</span>
                  )}
                </div>
                <h2 class="card-title">{projet.data.titre}</h2>
                <p class="card-tagline">{projet.data.tagline}</p>
                {projet.data.metriques && (
                  <div class="card-metriques">
                    {projet.data.metriques.slice(0, 3).map((m) => (
                      <div class="card-metrique">
                        <span class="metrique-val">{m.valeur}</span>
                        <span class="metrique-lbl">{m.label}</span>
                      </div>
                    ))}
                  </div>
                )}
                <span class="card-cta">Voir le projet →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJETS SECONDAIRES -->
    <section class="secondary-section">
      <div class="container">
        <div class="section-label" data-reveal>Autres projets</div>
        <div class="secondary-grid">
          {secondary.map((projet) => (
            <a href={`/projets/${projet.id}`} class="card-secondary">
              <div class="card-sec-img">
                {projet.data.image ? (
                  <img
                    src={projet.data.image}
                    alt={projet.data.titre}
                    width="600"
                    height="340"
                    loading="lazy"
                    decoding="async"
                    onerror="this.parentElement.classList.add('no-img')"
                  />
                ) : null}
                {projet.data.contexteGroupe && (
                  <span class="badge-groupe">Projet de groupe</span>
                )}
              </div>
              <div class="card-sec-body">
                <div class="card-stack">
                  {projet.data.stack.slice(0, 3).map((tech) => (
                    <span class="tag-muted">{tech}</span>
                  ))}
                  {projet.data.stack.length > 3 && (
                    <span class="tag-muted">+{projet.data.stack.length - 3}</span>
                  )}
                </div>
                <h2 class="card-sec-title">{projet.data.titre}</h2>
                <p class="card-sec-tagline">{projet.data.tagline}</p>
                <span class="card-cta-sm">Voir →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ─── Hero ─────────────────────────────────────── */
  .hero-projets {
    position: relative;
    padding: 90px 0 64px;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    top: -100px;
    left: 50%;
    width: 600px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--accent-soft), transparent 72%);
    filter: blur(20px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .page-title {
    font: 700 clamp(42px, 6vw, 72px) / 1.02 'Space Grotesk', sans-serif;
    letter-spacing: -0.03em;
    margin: 16px 0 0;
    color: var(--text);
  }

  .page-title span {
    color: var(--accent);
  }

  .page-desc {
    font: 400 18px / 1.6 'Manrope', sans-serif;
    color: var(--muted);
    max-width: 560px;
    margin: 16px 0 0;
  }

  /* ─── Sections ─────────────────────────────────── */
  .featured-section {
    padding: 56px 0 80px;
    border-top: 1px solid var(--line);
  }

  .secondary-section {
    padding: 56px 0 96px;
    border-top: 1px solid var(--line);
  }

  .section-label {
    margin-bottom: 28px;
  }

  /* ─── Featured cards ────────────────────────────── */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card-featured {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.25s ease;
  }

  .card-featured:hover {
    border-color: var(--accent-soft);
    transform: translateY(-4px);
  }

  .card-img {
    position: relative;
    aspect-ratio: 16/9;
    background: repeating-linear-gradient(
      135deg,
      #16161c,
      #16161c 12px,
      #1b1b22 12px,
      #1b1b22 24px
    );
    overflow: hidden;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-img.no-img img {
    display: none;
  }

  .card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(11, 11, 15, 0.6) 100%);
  }

  .badge-groupe {
    position: absolute;
    top: 12px;
    right: 12px;
    font: 600 11px 'Manrope', sans-serif;
    color: var(--muted);
    background: rgba(11, 11, 15, 0.72);
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 20px;
    backdrop-filter: blur(8px);
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .card-title {
    font: 700 22px 'Space Grotesk', sans-serif;
    color: var(--text);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .card-tagline {
    font: 400 14px / 1.6 'Manrope', sans-serif;
    color: #bcbcc4;
    margin: 10px 0 0;
    flex: 1;
  }

  .card-metriques {
    display: flex;
    gap: 16px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .card-metrique {
    display: flex;
    flex-direction: column;
  }

  .metrique-val {
    font: 700 20px 'Space Grotesk', sans-serif;
    color: var(--accent);
    line-height: 1;
  }

  .metrique-lbl {
    font: 500 11px 'Manrope', sans-serif;
    color: var(--muted);
    margin-top: 4px;
    white-space: nowrap;
  }

  .card-cta {
    display: inline-block;
    margin-top: 18px;
    font: 700 13px 'Manrope', sans-serif;
    color: var(--accent);
    transition: letter-spacing 0.2s ease;
  }

  .card-featured:hover .card-cta {
    letter-spacing: 0.02em;
  }

  /* ─── Secondary cards ───────────────────────────── */
  .secondary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .card-secondary {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.25s ease;
  }

  .card-secondary:hover {
    border-color: var(--accent-soft);
    transform: translateY(-3px);
  }

  .card-sec-img {
    position: relative;
    aspect-ratio: 16/9;
    background: repeating-linear-gradient(
      135deg,
      #16161c,
      #16161c 10px,
      #1b1b22 10px,
      #1b1b22 20px
    );
    overflow: hidden;
  }

  .card-sec-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-sec-img.no-img img {
    display: none;
  }

  .card-sec-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-sec-title {
    font: 700 17px 'Space Grotesk', sans-serif;
    color: var(--text);
    letter-spacing: -0.01em;
    margin: 10px 0 0;
  }

  .card-sec-tagline {
    font: 400 13px / 1.55 'Manrope', sans-serif;
    color: #bcbcc4;
    margin: 8px 0 0;
    flex: 1;
  }

  .card-cta-sm {
    display: inline-block;
    margin-top: 14px;
    font: 700 12px 'Manrope', sans-serif;
    color: var(--accent);
  }

  /* ─── Shared ─────────────────────────────────────── */
  .tag-muted {
    font: 500 11px 'Manrope', sans-serif;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 3px 9px;
    border-radius: 6px;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 1024px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
    }

    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .featured-grid,
    .secondary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
